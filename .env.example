# App settings use the ARA_ prefix.
# ARA_MODEL=groq:openai/gpt-oss-120b
# ARA_FALLBACK_MODEL=
# ARA_SEARCH_BUDGET=6
# ARA_MAX_SEARCH_RESULTS=5
# ARA_SNIPPET_CHARS=300
# ARA_MAX_PAGE_CHARS=3000
# ARA_MCP_RESULT_CHARS=3000
# ARA_RECURSION_LIMIT=50
# ARA_OUTPUT_DIR=output
# ARA_SKILLS_DIR=skills
# ARA_MCP_CONFIG_PATH=mcp_servers.json
# ARA_MCP_ENABLED=true
# ARA_MCP_TIMEOUT_SECONDS=30
# ARA_LOG_LEVEL=INFO

# Provider keys are unprefixed secrets.
# GROQ_API_KEY=
# GOOGLE_API_KEY=  # Optional: enables the Gemini spike candidate and provider.
# TAVILY_API_KEY=

# Required only when the SEC EDGAR MCP server is enabled. Use your real name and
# email per SEC fair-access rules, e.g. Your Name your.email@example.com.
# SEC_EDGAR_USER_AGENT=
