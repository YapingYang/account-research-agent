# App settings use the ARA_ prefix.
# ARA_MODEL=anthropic:claude-opus-5-5   # or anthropic:claude-sonnet-5-5 / anthropic:claude-haiku-5-5
# ARA_ANTHROPIC_EFFORT=medium            # low | medium | high | xhigh | max
# ARA_FALLBACK_MODEL=
# ARA_MAX_MODEL_CALLS=15
# ARA_MAX_REQUEST_TOKENS=   # unset: 6500 for groq, 32000 for other providers
# ARA_SEARCH_BUDGET=4
# ARA_MAX_PAGE_FETCHES=2
# ARA_MAX_SEC_CALLS=4
# ARA_MAX_TOTAL_WAIT_SECONDS=300
# ARA_RATE_LIMIT_DEFAULT_WAIT_SECONDS=60
# ARA_RATE_LIMIT_BACKOFF_BASE_SECONDS=2
# ARA_RATE_LIMIT_BACKOFF_CAP_SECONDS=15
# ARA_TRACING_BACKEND=langsmith
# ARA_MAX_SEARCH_RESULTS=5
# ARA_SNIPPET_CHARS=300
# ARA_MAX_PAGE_CHARS=3000
# ARA_MCP_RESULT_CHARS=3000
# ARA_RECURSION_LIMIT=50
# ARA_OUTPUT_DIR=output
# ARA_SKILLS_DIR=skills
# ARA_MCP_CONFIG_PATH=mcp_servers.json
# ARA_MCP_ENABLED=false
# ARA_MCP_TIMEOUT_SECONDS=30
# ARA_LOG_LEVEL=INFO

# Provider keys are unprefixed secrets.
# ANTHROPIC_API_KEY=   # required for the default anthropic:claude-opus-5-5 model
# GROQ_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=  # Optional: enables the Gemini spike candidate and provider.
# TAVILY_API_KEY=

# Required only when the SEC EDGAR MCP server is enabled. Use your real name and
# email per SEC fair-access rules, e.g. Your Name your.email@example.com.
# SEC_EDGAR_USER_AGENT="Your Name your.email@example.com"

# LangSmith tracing (default backend)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=account-research-demo

# Langfuse tracing (alternative backend)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
