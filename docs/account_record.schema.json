{
  "$defs": {
    "Claim": {
      "description": "One factual statement supported by one or more registered source IDs.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^S\\d+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "source_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Source": {
      "description": "A source used in the account brief.",
      "properties": {
        "id": {
          "pattern": "^S\\d+$",
          "title": "Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "kind": {
          "enum": [
            "search_result",
            "web_page",
            "sec_filing"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "url",
        "title",
        "retrieved_at",
        "kind"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "description": "CRM-ready account record assembled and validated by application code.",
  "properties": {
    "company_name": {
      "title": "Company Name",
      "type": "string"
    },
    "domain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain"
    },
    "industry": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Industry"
    },
    "is_public": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Is Public"
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/Claim"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "financial_highlights": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Financial Highlights",
      "type": "array"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Signals",
      "type": "array"
    },
    "priorities": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Priorities",
      "type": "array"
    },
    "pain_points": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Pain Points",
      "type": "array"
    },
    "talking_points": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Talking Points",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "flags": {
      "items": {
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    }
  },
  "required": [
    "company_name",
    "generated_at",
    "model"
  ],
  "title": "AccountRecord",
  "type": "object"
}
